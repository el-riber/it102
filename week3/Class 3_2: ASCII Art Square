<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ASCII Art Square</title>
</head>
<body>
  <h2>ASCII Art Square</h2>
  <pre id="filled"></pre>
  <pre id="hollow"></pre>

  <script>
    
    let size = prompt("Enter a square size between 3 and 30:");
    
   
    while (isNaN(size) || size < 3 || size > 30) {
      size = prompt("Invalid input. Please enter a number between 3 and 30:");
    }

    size = Number(size); // Convert to number

    
    let filled = "";
    for (let row = 0; row < size; row++) {
      for (let col = 0; col < size; col++) {
        filled += "*";
      }
      filled += "\n";
    }

    
    let hollow = "";
    for (let row = 0; row < size; row++) {
      for (let col = 0; col < size; col++) {
        if (row === 0 || row === size - 1 || col === 0 || col === size - 1) {
          hollow += "*";
        } else {
          hollow += " ";
        }
      }
      hollow += "\n";
    }

    
    document.getElementById("filled").textContent = filled;
    document.getElementById("hollow").textContent = hollow;
  </script>
</body>
</html>
